@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
    <p><img src="~/images/proxy-image.png" class="img-fluid" alt="Responsive image"></p>

    <div class="form-group mt-4">
        <label for="nombre">Escribe tu nombre</label>
        <input type="text" class="form-control" id="nombre" placeholder="Introduce tu nombre">
    </div>
    <button type="button" class="btn btn-outline-success btn-lg mt-3" onclick="mostrarAlerta()">Mostrar Alerta</button>
</div>

<script>
    function mostrarAlerta() {
        let nombre = document.getElementById('nombre').value;
        alert("Mi nombre es Juan Perez, mi curso es Desarrollo Web y mi hobbie es Programación. El valor del campo de texto es: " + nombre);
    }
</script>

